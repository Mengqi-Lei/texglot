{
  "name": "texglot-desktop",
  "version": "1.0.5",
  "description": "Local arXiv and LaTeX paper translation",
  "author": "TeXGlot contributors",
  "license": "Apache-2.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@electron/get": "5.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.texglot.desktop",
    "productName": "TeXGlot",
    "asar": true,
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "service.cjs",
      "updates.cjs",
      "preload.cjs",
      "loading.html",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "engine-dist/texglot-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "build/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "build/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "TeXGlot-${version}-macOS-${arch}.${ext}"
    },
    "dmg": {
      "title": "TeXGlot",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 180
        },
        {
          "x": 390,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "TeXGlot-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "TeXGlot"
    },
    "afterPack": "after-pack.cjs"
  }
}
